# Создай Telegram-бота через https://t.me/BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=
# Числовые Telegram ID через запятую. Если пусто, доступна только /id.
ALLOWED_TELEGRAM_IDS=
GITHUB_OWNER=kenshiki36-blip
# Для приватных репозиториев: Contents Read-only и доступ к нужным проектам.
GITHUB_TOKEN=

# Провайдер: xai (Grok), groq или gemini.
AI_PROVIDER=xai
# Grok от xAI: https://console.x.ai — скрытый ввод через setup-grok.cmd.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
# Время ожидания ИИ перед переходом к локальному поиску: 5–120 секунд.
AI_TIMEOUT_SECONDS=45

# Groq: setup-groq.cmd (отдельный сервис, не xAI).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini: setup-gemini.cmd и проект Google AI Studio с нужным тарифом.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Максимум текстовых файлов на репозиторий: 1–500.
MAX_FILES=100

# Allow all Telegram users; ALLOWED_TELEGRAM_IDS retain owner privileges.
PUBLIC_ACCESS=false
# Дневные лимиты для посторонних при PUBLIC_ACCESS=true (на владельца не действуют).
# Вопросы к ИИ тратят деньги владельца API-ключа. 0 — запретить. Сброс в 00:00 UTC; перезапуск сохраняет счётчики.
PUBLIC_DAILY_QUESTIONS=20
# Загрузки проектов (/repo, /refresh) на одного человека в день.
PUBLIC_DAILY_INDEXES=5
